builddir = build
cxxflags = -target x86-windows-gnu -std=c++20 -O2 -g -fwrapv -fno-strict-aliasing -w -Iruntime -Isrc -Ithird_party/libffi/include

rule pch
  command = zig c++ $cxxflags -x c++-header -fpch-instantiate-templates -MMD -MF $out.d -c $in -o $out
  description = PCH $in
  depfile = $out.d
  deps = gcc

rule cxx
  command = zig c++ $cxxflags $pch -MMD -MF $out.d -c $in -o $out
  description = CXX $in
  depfile = $out.d
  deps = gcc

rule cc
  command = zig cc -target x86-windows-gnu -O2 -fexceptions -Ithird_party/libffi/include -MMD -MF $out.d -c $in -o $out
  description = CC $in
  depfile = $out.d
  deps = gcc

rule archive
  command = zig ar rcs $out $in
  description = AR $out

rule link
  command = zig c++ -target x86-windows-gnu @$out.rsp -Wl,--subsystem,windows -loleaut32 -luser32 -lgdi32 -ld3d9 -o $out && python3 tools/large_address_aware.py $out
  description = LINK $out
  rspfile = $out.rsp
  rspfile_content = $in

build build/runtime.pch: pch src/runtime_support.hpp

build build/obj/Achievements.o: cxx src/Achievements.cpp | build/runtime.pch
  pch = -include-pch build/runtime.pch
build build/obj/ActiveXSdk.o: cxx src/ActiveXSdk.cpp | build/runtime.pch
